


generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}





enum UserRole {
  SUPER_ADMIN
  ADMIN
  PRODUCTION_OPERATOR
  CLUB_ADMIN
  CLUB_VIEWER
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  mustChangePassword Boolean   @default(false)
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  clubUsers ClubUser[]
  orders    Order[]

  @@index([role])
}


model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}





model Club {
  id                             String                 @id @default(cuid())
  name                           String
  slug                           String                 @unique
  sport                          String?
  description                    String?
  logoUrl                        String?
  isActive                       Boolean                @default(true)
  payoutCbu                      String?

  mobbexEntityId                 String?                @unique
  mobbexSubmittedEntityId        String?
  mobbexOnboardingStatus         MobbexOnboardingStatus @default(NOT_STARTED)
  mobbexTaxId                    String?
  mobbexLegalName                String?
  mobbexContactName              String?
  mobbexContactEmail             String?
  mobbexContactPhone             String?
  mobbexSubmittedAt              DateTime?
  mobbexAccessRequestedAt        DateTime?
  mobbexAuthorizationConfirmedAt DateTime?
  mobbexActivatedAt              DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  users             ClubUser[]
  products          Product[]
  agreements        Agreement[]
  commissionEntries CommissionEntry[]
  settlements       Settlement[]
  designs           Design[]

  @@index([isActive])
}

enum MobbexOnboardingStatus {
  NOT_STARTED
  REGISTRATION_PENDING
  DETAILS_SUBMITTED
  ACCESS_REQUESTED
  AUTHORIZATION_CONFIRMED
  ACTIVE
}

model ClubUser {
  id     String @id @default(cuid())
  clubId String
  userId String

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}





enum ProductLine {
  CLUB
  URBANA
  TRAINING
  TRABAJO
  ESCOLAR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  OUT_OF_STOCK
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model CatalogLine {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  code              String        @unique
  description       String?
  priceInCents      Int
  compareAtCents    Int?
  line              ProductLine?
  status            ProductStatus @default(DRAFT)
  allowsCustomPrint Boolean       @default(false)
  isFeatured        Boolean       @default(false)
  showStock         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  lineId         String?
  lineDefinition CatalogLine? @relation(fields: [lineId], references: [id])

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  images      ProductImage[]
  variants    ProductVariant[]
  designLinks ProductDesign[]

  @@index([status])
  @@index([line])
  @@index([lineId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  color     String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  size      String
  color     String
  stock     Int?
  sku       String @unique

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
}




model UploadedImage {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([createdAt])
}





enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PRODUCTION
  READY_FOR_SHIPPING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  SHIPPING
  PICKUP
}

enum ProductionItemStatus {
  WAITING
  SCHEDULED
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
}

model Order {
  id                String         @id @default(cuid())
  checkoutRequestId String?        @unique
  orderNumber       Int            @default(autoincrement())
  status            OrderStatus    @default(PENDING_PAYMENT)
  contactName       String
  customerDocument  String?
  // Datos fiscales del comprador. Sin CUIT se factura a consumidor final.
  customerTaxId        String?
  customerLegalName    String?
  customerTaxCondition TaxCondition?
  contactEmail      String
  contactPhone      String
  deliveryMethod    DeliveryMethod

  shippingAddress    String?
  shippingCity       String?
  shippingPostalCode String?

  subtotalInCents Int
  shippingInCents Int @default(0)
  totalInCents    Int

  receiptEmailSentAt     DateTime?
  receiptEmailProviderId String?
  stockReleasedAt        DateTime?
  deliveredAt            DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  productionBatchId   String?
  productionBatch     ProductionBatch? @relation(fields: [productionBatchId], references: [id])
  productionRemovedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  commissionEntries CommissionEntry[]
  customerRequests  CustomerRequest[]
  fiscalVouchers    FiscalVoucher[]

  @@index([status])
  @@index([status, stockReleasedAt, createdAt])
  @@index([contactEmail])
  @@index([productionBatchId])
  @@index([productionRemovedAt])
}



model ManualProductionItem {
  id          String  @id @default(cuid())
  productName String
  size        String
  color       String
  quantity    Int
  notes       String?

  productionStatus      ProductionItemStatus @default(WAITING)
  productionScheduledAt DateTime?
  productionStartedAt   DateTime?
  productionReadyAt     DateTime?
  productionShippedAt   DateTime?
  productionDeliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionStatus])
  @@index([productionScheduledAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  productName String
  productSlug String
  variantId   String
  size        String
  color       String
  imageUrl    String?

  priceInCentsSnapshot Int
  quantity             Int
  lineTotalInCents     Int
  stockReserved        Boolean @default(false)

  clubId              String?
  clubNameSnapshot    String?
  // Convenio y porcentaje del club vigentes al crear el pedido. El split y la
  // comisión usan estos valores para que no cambien si se edita el convenio.
  clubAgreementId     String?
  clubSharePercentage Int?

  productionStatus      ProductionItemStatus @default(WAITING)
  productionScheduledAt DateTime?
  productionStartedAt   DateTime?
  productionReadyAt     DateTime?
  productionShippedAt   DateTime?
  productionDeliveredAt DateTime?

  commissionEntries CommissionEntry[]
  requestItems      CustomerRequestItem[]

  @@index([orderId])
  @@index([productionStatus])
  @@index([productionScheduledAt])
}

model OrderStatusHistory {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}





enum PaymentChannel {
  MP_WALLET
  CARD
  MODO
  MOBBEX_CHECKOUT
}

enum PaymentProvider {
  MERCADO_PAGO
  PAYWAY
  MODO
  MOBBEX
}

enum PaymentProcessor {
  MERCADO_PAGO
  PAYWAY
  MOBBEX
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  channel   PaymentChannel
  provider  PaymentProvider
  processor PaymentProcessor

  providerPreferenceId String?
  providerPaymentId    String?
  amountInCents        Int
  currency             String        @default("ARS")
  status               PaymentStatus @default(CREATED)
  providerStatus       String?
  idempotencyKey       String        @unique

  approvedAt DateTime?
  rejectedAt DateTime?

  paymentMethodType       String?
  paymentMethodId         String?
  installments            Int?
  moneyReleaseDate        DateTime?
  moneyReleasedAt         DateTime?
  netReceivedInCents      Int?
  feeInCents              Int?
  financingFeeInCents     Int?
  amountRefundedInCents   Int       @default(0)




  lastProviderRefundId    String?
  lastRefundAmountInCents Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commissionEntries CommissionEntry[]
  customerRequests  CustomerRequest[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
  @@index([orderId, status, updatedAt])
  @@index([provider, status, createdAt])
}

model PaymentWebhookEvent {
  id String @id @default(cuid())

  provider         PaymentProvider
  providerEventId  String
  eventType        String
  processingStatus String          @default("RECEIVED")

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, providerEventId])
}





enum SettlementMethod {
  TRANSFER
  SPLIT_MP
}

enum SettlementFrequency {
  AUTOMATIC
  BIWEEKLY
  MONTHLY
}

enum AgreementStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

model Agreement {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  code   String          @unique
  title  String
  status AgreementStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  basePercentage      Int
  settlementMethod    SettlementMethod    @default(TRANSFER)

  settlementFrequency SettlementFrequency @default(AUTOMATIC)
  contractUrl         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productRates      AgreementProductRate[]
  commissionEntries CommissionEntry[]
  changes           AgreementChange[]

  @@index([clubId])
  @@index([status])
}

model AgreementChange {
  id              String    @id @default(cuid())
  agreementId     String
  agreement       Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  action          String
  summary         String
  changedByUserId String?
  details         Json?
  createdAt       DateTime  @default(now())

  @@index([agreementId, createdAt])
}

model AgreementProductRate {
  id String @id @default(cuid())

  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  productId  String
  percentage Int

  @@unique([agreementId, productId])
}





enum CommissionStatus {
  ACCRUED
  PENDING_RELEASE
  PENDING_DELIVERY
  RETURN_WINDOW
  AVAILABLE
  IN_SETTLEMENT
  SETTLED
  REVERSED
}

enum CommissionEntryType {
  SALE
  REFUND_ADJUSTMENT
}

model CommissionEntry {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])

  orderId     String
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  paymentId   String?
  payment     Payment?  @relation(fields: [paymentId], references: [id])
  orderNumber Int
  productName String

  entryType CommissionEntryType @default(SALE)
  sourceKey String              @unique

  baseAmountInCents Int
  percentageApplied Int
  amountInCents     Int

  status CommissionStatus @default(PENDING_RELEASE)

  releasedAt         DateTime?
  returnWindowEndsAt DateTime?
  availableAt        DateTime?
  reversedAt         DateTime?
  reversalReason     String?

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  createdAt DateTime @default(now())

  @@index([clubId])
  @@index([status])
  @@index([settlementId])
  @@index([paymentId])
  @@index([orderItemId])
  @@index([availableAt])
}





enum CustomerRequestType {
  WITHDRAWAL
  RETURN
  CLAIM
}

enum CustomerRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REFUND_PROCESSING
  REFUNDED
  CLOSED
}

model CustomerRequest {
  id         String @id @default(cuid())
  publicCode String @unique @default(cuid())

  type   CustomerRequestType
  status CustomerRequestStatus @default(REQUESTED)

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  customerEmail String
  reason        String
  details       String?

  requestedRefundInCents Int
  approvedRefundInCents  Int?
  providerRefundId       String?
  providerRefundStatus   String?
  refundIdempotencyKey   String? @unique

  eligibilitySnapshot Json?
  reviewedByUserId    String?
  reviewNote          String?
  reviewedAt          DateTime?
  refundedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items CustomerRequestItem[]

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model CustomerRequestItem {
  id String @id @default(cuid())

  requestId   String
  request     CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id])

  quantity          Int
  unitAmountInCents Int
  lineAmountInCents Int

  @@unique([requestId, orderItemId])
  @@index([orderItemId])
}





enum SettlementStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

model Settlement {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  periodLabel  String
  periodStart  DateTime
  periodEnd    DateTime
  status       SettlementStatus @default(PENDING_PAYMENT)
  totalInCents Int


  transferProvider    String?
  transferId          String?
  transferStatus      String?
  transferLastEventAt DateTime?
  transferAttempts    Int       @default(0)
  transferLastError   String?

  receiptUrl        String?
  paidAt            DateTime?
  confirmedByUserId String?
  createdByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries CommissionEntry[]
  events  SettlementEvent[]

  @@unique([clubId, periodStart, periodEnd])
  @@index([clubId])
  @@index([status])
}

model SettlementEvent {
  id              String     @id @default(cuid())
  settlementId    String
  settlement      Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  action          String
  summary         String
  changedByUserId String?
  createdAt       DateTime   @default(now())

  @@index([settlementId, createdAt])
}

model UploadedDocument {
  id           String   @id @default(cuid())
  originalName String
  mimeType     String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  @@index([createdAt])
}





enum DesignStatus {
  PENDING_SEND
  SENT_TO_CLUB
  CHANGES_REQUESTED
  APPROVED
}

model Design {
  id String @id @default(cuid())

  clubId String?
  club   Club?   @relation(fields: [clubId], references: [id])

  customerName String?

  title  String
  status DesignStatus @default(PENDING_SEND)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions     DesignVersion[]
  comments     DesignComment[]
  productLinks ProductDesign[]

  @@index([clubId])
  @@index([status])
}

model DesignVersion {
  id String @id @default(cuid())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  versionNumber Int
  title         String?
  description   String?
  imageUrl      String
  status        DesignStatus @default(PENDING_SEND)
  changeNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments DesignComment[]
  images   DesignVersionImage[]

  @@unique([designId, versionNumber])
}

model DesignVersionImage {
  id        String        @id @default(cuid())
  versionId String
  version   DesignVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  url      String
  position Int    @default(0)

  createdAt DateTime @default(now())

  @@unique([versionId, position])
  @@index([versionId])
}

model DesignComment {
  id String @id @default(cuid())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  versionId String?
  version   DesignVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  authorUserId String
  authorName   String
  message      String

  createdAt DateTime @default(now())

  @@index([designId])
  @@index([versionId])
}

model ProductDesign {
  id String @id @default(cuid())

  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([designId, productId])
}





enum ProductionBatchStatus {
  OPEN
  CLOSED
}

model ProductionBatch {
  id          String                @id @default(cuid())
  batchNumber Int                   @default(autoincrement())
  periodDays  Int                   @default(10)
  status      ProductionBatchStatus @default(OPEN)

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  orders Order[]

  @@index([status])
}





model HomeContentPiece {
  id String @id @default(cuid())

  code        String @unique
  section     String @default("HERO")
  title       String
  eyebrow     String
  description String

  desktopImageUrl   String
  mobileImageUrl    String
  ctaLabel          String
  ctaHref           String
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  tags              String[]

  status    String    @default("VISIBLE")
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([section, sortOrder])
  @@index([status])
}

model SiteContentSetting {
  id String @id @default("home")

  carouselEnabled    Boolean  @default(true)
  carouselIntervalMs Int      @default(4000)
  returnWindowDays   Int      @default(10)
  updatedAt          DateTime @updatedAt
}





enum SpecialRequestStatus {
  NEW
  CONTACTED
  CONVERTED
  DECLINED
}

model SpecialRequest {
  id String @id @default(cuid())

  status SpecialRequestStatus @default(NEW)

  contactName    String
  whatsapp       String
  garmentType    String
  estimatedQty   String
  sizesAndColors String
  neededBy       String?
  comments       String?
  attachmentName String?

  createdAt DateTime @default(now())

  @@index([status])
}





model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}

enum TaxCondition {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTO
  EXENTO
}

enum FiscalVoucherKind {
  INVOICE
  CREDIT_NOTE
}

enum FiscalVoucherStatus {
  PENDING
  PROCESSING
  AWAITING_AUTHORIZATION
  ISSUED
  FAILED
}

// Comprobante fiscal (factura o nota de crédito) emitido en ARCA a través del
// proveedor de facturación. Se reintenta solo hasta quedar emitido.
model FiscalVoucher {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  kind           FiscalVoucherKind
  voucherType    String
  idempotencyKey String              @unique
  status         FiscalVoucherStatus @default(PENDING)

  amountInCents    Int
  netAmountInCents Int
  vatAmountInCents Int

  buyerDocType      String
  buyerDocNumber    String
  buyerName         String
  buyerTaxCondition TaxCondition

  provider          String
  providerVoucherId String?
  pointOfSale       Int?
  number            Int?
  cae               String?
  caeExpiresAt      DateTime?
  pdfUrl            String?
  issuedAt          DateTime?
  emailSentAt       DateTime?

  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  errorMessage  String?

  relatedVoucherId String?
  relatedVoucher   FiscalVoucher?  @relation("CreditNoteOf", fields: [relatedVoucherId], references: [id])
  creditNotes      FiscalVoucher[] @relation("CreditNoteOf")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status, nextAttemptAt])
  @@index([providerVoucherId])
  @@index([createdAt])
}
